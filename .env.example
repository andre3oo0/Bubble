# Copy this file to .env for local development and fill in the values. Never commit .env.
# In production, set these in your host's environment settings instead of a file.

# --- Required ---------------------------------------------------------------

# AI key. Free: https://console.groq.com/keys (also set OPENAI_BASE_URL and
# OPENAI_MODEL below). Paid: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Signs login cookies. Long and random; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# The public address of the app, no trailing slash. Locally http://localhost:5000,
# in production e.g. https://bubble.example.com. Links in emails use this.
BETTER_AUTH_URL=http://localhost:5000

# --- Required in production --------------------------------------------------

# Postgres connection string (Neon, Supabase...). Leave unset locally to use the
# built-in database stored in .data/pglite
# DATABASE_URL=postgres://user:password@host:5432/bubble

# Password reset and email confirmation, via https://brevo.com (free, no domain
# needed; EMAIL_FROM must be a sender verified in Brevo). RESEND_API_KEY works
# instead, but Resend needs a verified domain. Brevo is used if both are set.
# Without these, emails are printed to the server console (fine locally only).
# BREVO_API_KEY=
# RESEND_API_KEY=
# EMAIL_FROM=Bubble <bubble@example.com>

# --- Optional ------------------------------------------------------------------

# "Continue with Google". Free: create a Web application client at
# https://console.cloud.google.com (Google Auth Platform > Clients) with the
# redirect URI <BETTER_AUTH_URL>/api/auth/callback/google. The button only shows
# when both are set.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# For Groq. Leave both unset for OpenAI. The model must support structured
# outputs; OPENAI_MODEL defaults to gpt-4.1-mini
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=openai/gpt-oss-120b

# How hard reasoning models (gpt-oss, o-series) think before replying: low, medium,
# high or none. Defaults to medium for those models; others never get it.
# OPENAI_REASONING_EFFORT=

# Defaults to 5000. Most hosts set this for you.
# PORT=5000

# AI messages per day. 0 turns guest chat off (crisis replies still work).
# CHAT_DAILY_LIMIT_USER=150
# CHAT_DAILY_LIMIT_GUEST=40
# CHAT_PER_MINUTE_LIMIT=20

# Android app (APK built with PWABuilder). The current APK's details are built in
# (server/app.ts). Set these only for a new signing key or domain; both come from
# the assetlinks.json in PWABuilder's download. ANDROID_PACKAGE_NAME=none turns it off.
# ANDROID_PACKAGE_NAME=
# ANDROID_CERT_SHA256=

# Proxies in front of the app. Defaults to 1 in production (right for Render,
# Railway, Fly.io). Set 0 only if the app is exposed directly to the internet.
# TRUST_PROXY=1
