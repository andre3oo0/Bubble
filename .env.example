# Copy this file to .env and fill in the values. Never commit .env.

# Required: the server will not start without it
OPENAI_API_KEY=

# Optional: chat model, must support structured outputs. Defaults to gpt-4.1-mini
# OPENAI_MODEL=

# Optional: defaults to 5000
PORT=5000

# Postgres connection string (Neon, Supabase, etc). Required in production.
# Leave it unset locally to use the built-in database stored in .data/pglite
# DATABASE_URL=postgres://user:password@host:5432/bubble

# Signs session cookies. Required in production, use a long random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# The public URL of the app, e.g. https://bubble.example.com
BETTER_AUTH_URL=http://localhost:5000
